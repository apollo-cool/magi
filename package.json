{
  "name": "magi",
  "productName": "magi",
  "version": "1.0.0",
  "private": true,
  "description": "My Electron application description",
  "keywords": [],
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "apollo",
    "email": "appllo_cool@proton.me"
  },
  "main": "./dist/index.js",
  "scripts": {
    "start": "tsc && cp src/index.html dist && cp src/styles.css dist && cp -r src/pages dist && electron-forge start dist",
    "lint": "echo \"No linting configured\"",
    "make": "tsc && cp src/index.html dist && cp src/styles.css dist && cp -r src/pages dist && electron-forge make dist",
    "package": "tsc && cp src/index.html dist && cp src/styles.css dist && cp -r src/pages dist && electron-forge package dist"
  },
  "dependencies": {
    "ollama": "^0.6.4",
    "readline": "^1.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-appx": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "electron": "^44.7.0",
    "electron-squirrel-startup": "^1.0.1",
    "typescript": "^7.0.2"
  },
  "config": {
    "forge": {
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ],
          "config": {}
        },
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "electron_quick_start"
          }
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ]
    }
  }
}
